# Copy to .env.local (local) or set these in Vercel > Project > Settings > Environment Variables
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=online_course
JWT_SECRET=change-me-to-a-long-random-string
# Exact origin of the deployed frontend (no trailing slash). Local default: http://localhost:5173
FRONTEND_URL=http://localhost:5173
